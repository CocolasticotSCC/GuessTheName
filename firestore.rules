rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jeux : lisibles par tous (quiconque a le lien), créés par un
    // utilisateur anonyme authentifié, modifiables uniquement par leur
    // créateur (même navigateur), jamais supprimables.
    match /games/{gameId} {
      function validGame() {
        return request.resource.data.keys().hasOnly(['t', 'n', 'e', 'l', 'th', 'vp', 'owner', 'ts'])
          && request.resource.data.t is string
          && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 100
          && request.resource.data.n is list
          && request.resource.data.n.size() >= 2 && request.resource.data.n.size() <= 300
          && (!('e' in request.resource.data)
              || (request.resource.data.e is string && request.resource.data.e.size() <= 120))
          && (!('l' in request.resource.data)
              || (request.resource.data.l is string && request.resource.data.l.size() <= 300))
          && (!('th' in request.resource.data)
              || (request.resource.data.th is string && request.resource.data.th.size() <= 20))
          && (!('vp' in request.resource.data) || request.resource.data.vp is bool)
          && request.resource.data.owner is string
          && request.resource.data.ts is number;
      }
      allow read: if true;
      allow create: if request.auth != null
        && validGame()
        && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && validGame()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner;
      allow delete: if false;
    }

    // Pronos du jeu : tout le monde peut lire et ajouter.
    // Un navigateur peut remplacer son propre prono (même id de document),
    // mais jamais changer le jeu auquel il appartient, ni supprimer.
    match /guesses/{guessId} {
      // Élément i du top 4 : absent, ou prénom de 60 caractères max
      function topItem(top, i) {
        return top.size() <= i || (top[i] is string && top[i].size() <= 60);
      }
      function validGuess() {
        return request.resource.data.keys().hasOnly(['g', 'who', 'name', 'top', 'msg', 'ts'])
          && request.resource.data.g is string
          && request.resource.data.g.size() > 0 && request.resource.data.g.size() <= 40
          && request.resource.data.who is string
          && request.resource.data.who.size() > 0 && request.resource.data.who.size() <= 60
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
          && (!('top' in request.resource.data)
              || (request.resource.data.top is list
                  && request.resource.data.top.size() <= 4
                  && topItem(request.resource.data.top, 0) && topItem(request.resource.data.top, 1)
                  && topItem(request.resource.data.top, 2) && topItem(request.resource.data.top, 3)))
          && request.resource.data.msg is string
          && request.resource.data.msg.size() <= 250
          && request.resource.data.ts is number;
      }
      allow read: if true;
      allow create: if validGuess();
      allow update: if validGuess() && request.resource.data.g == resource.data.g;
      allow delete: if false;
    }
    // Commentaires sur les prénoms : tout le monde peut lire et ajouter.
    // Seul le créateur du jeu peut masquer / rétablir un commentaire
    // (uniquement le champ hidden). Jamais de suppression.
    match /comments/{commentId} {
      function validComment() {
        return request.resource.data.keys().hasOnly(['g', 'name', 'who', 'msg', 'ts', 'hidden'])
          && request.resource.data.g is string
          && request.resource.data.g.size() > 0 && request.resource.data.g.size() <= 40
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
          && request.resource.data.who is string
          && request.resource.data.who.size() > 0 && request.resource.data.who.size() <= 60
          && request.resource.data.msg is string
          && request.resource.data.msg.size() > 0 && request.resource.data.msg.size() <= 300
          && request.resource.data.ts is number
          && request.resource.data.hidden is bool;
      }
      allow read: if true;
      allow create: if validComment() && request.resource.data.hidden == false;
      allow update: if request.auth != null
        && validComment()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
        && get(/databases/$(database)/documents/games/$(resource.data.g)).data.owner == request.auth.uid;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
